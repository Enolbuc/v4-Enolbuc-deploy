#!/bin/sh
# Git flow: в main и develop код попадает только через PR, рабочие ветки
# называются <type>/<slug>. То же самое проверяет CI на PR (.github/workflows/gitflow.yml).

remote="$1"
protected='^(main|develop)$'
allowed='^(feat|fix|refactor|test|docs|chore|ci|build|perf)/[a-z0-9][a-z0-9-]*$'

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    branch=${remote_ref#refs/heads/}
    [ "$branch" = "$remote_ref" ] && continue   # не ветка (тег и т.п.)

    if printf '%s' "$branch" | grep -Eq "$protected"; then
        # Разрешаем только первый push (создание ветки), дальше только через PR.
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            echo "pre-push: прямой push в '$branch' запрещён, открой PR" >&2
            fail=1
        fi
        continue
    fi

    if ! printf '%s' "$branch" | grep -Eq "$allowed"; then
        echo "pre-push: имя ветки '$branch' не по формату <type>/<slug>" >&2
        echo "  type: feat fix refactor test docs chore ci build perf; slug: [a-z0-9-]" >&2
        echo "  переименовать: git branch -m feat/<slug>" >&2
        fail=1
    fi
done

exit $fail
