# Скопируй в .env и заполни. Makefile подхватывает .env автоматически.
# Локальный стек из compose/ (make infra):
DATABASE_URL_CATALOG=postgres://app:app@localhost:5433/catalog?sslmode=disable
DATABASE_URL_ORDERS=postgres://app:app@localhost:5433/orders?sslmode=disable
DATABASE_URL_AUTH=postgres://app:app@localhost:5433/auth?sslmode=disable
REDIS_URL=redis://localhost:6380
KAFKA_BROKERS=localhost:9094
JWT_SECRET=devsecret

# Куда ходят acceptance-тесты. Локально это gateway из compose или go run.
# Для прогона против Railway подставь публичный домен gateway.
GATEWAY_URL=http://localhost:8080
